# Channels
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# X official API only
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# Optional AI captions
AI_ENABLED=false
OPENAI_API_KEY=

# Frontend
VITE_API_BASE_URL=/api/v1
